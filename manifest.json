{
  "name": "Bet Exporter",
  "version": "2.0",
  "manifest_version": 2,
  "description": "Export Bovada Bets",
  "icons" : {
    "16": "images/icon-16.png",
    "38": "images/icon-38.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "background": {
    "scripts": [
      "src/jquery.min.js",
      "src/load.js"
    ]
  },
  "browser_action": {
    "default_icon": "images/icon-128.png",
    "default_title": "Exporter",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["src/custom.css"],
      "js": ["src/custom.js"]
    }
  ]
}