{
  "manifest_version": 3,
  "name": "Fight Night Bet Sheet",
  "version": "3.0.0",
  "description": "Turn Bovada fight bets into a clean, printable fight-night cheat sheet.",
  "icons": {
    "16": "images/icon-16.png",
    "38": "images/icon-38.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "declarativeContent",
    "storage"
  ],
  "background": {
    "service_worker": "src/service-worker.js"
  },
  "action": {
    "default_icon": "images/icon-128.png",
    "default_title": "Create fight-night bet sheet",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bovada.lv/account/transactions"
      ],
      "js": [
        "src/extractor.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
